# Environment variables for Apache Superset experiment
# Copy this file to .env and customise before starting the stack.
# IMPORTANT: Never commit .env with real secrets to version control.

# Superset secret key – used for session signing and encrypting sensitive data.
# Change this to a long random string before running. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(42))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_key

# Superset metadata PostgreSQL
DATABASE_USER=superset
DATABASE_PASSWORD=superset
DATABASE_DB=superset

# Mock data PostgreSQL
MOCK_DB_USER=analyst
MOCK_DB_PASSWORD=analyst
MOCK_DB_NAME=financial_crime

# Superset admin account (created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@superset.local
