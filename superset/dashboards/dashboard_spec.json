    {
      "slug": "fcm-sla-performance",
      "title": "FCM: SLA & Performance Analytics",
      "description": "SLA compliance rates, breach root-cause analysis, team throughput and average case age — sliced by risk level, region and crime type.",
      "published": true,

      "filters": [
        { "type": "filter_select", "targets": ["region_name"],    "label": "Region",         "dataset": "vw_sla_performance" },
        { "type": "filter_select", "targets": ["team_name"],      "label": "Team",           "dataset": "vw_sla_performance" },
        { "type": "filter_select", "targets": ["risk_level"],     "label": "Risk Level",     "dataset": "vw_sla_performance" },
        { "type": "filter_select", "targets": ["crime_category"], "label": "Crime Category", "dataset": "vw_sla_performance" },
        { "type": "filter_time",   "targets": ["cohort_month"],   "label": "Cohort Month" }
      ],

      "charts": [
        { "id": "sla_compliance_by_team_bar",    "type": "bar",          "dataset": "vw_sla_performance",  "title": "SLA Compliance % by Team",          "x": "team_name",      "y": "sla_compliance_pct",  "color": "team_type" },
        { "id": "sla_trend_line",                "type": "line",         "dataset": "vw_sla_performance",  "title": "SLA Compliance Trend Over Time",    "x": "cohort_month",   "y": "sla_compliance_pct",  "breakdown": "region_name" },
        { "id": "breach_by_crime_type",          "type": "bar",          "dataset": "vw_sla_performance",  "title": "SLA Breaches by Crime Category",    "x": "crime_category", "y": "closed_sla_breached",  "sort": "desc" },
        { "id": "breach_by_risk_level",          "type": "pie",          "dataset": "vw_sla_performance",  "title": "SLA Breaches by Risk Level",        "dimension": "risk_level", "metric": "closed_sla_breached" },
        { "id": "avg_days_heatmap",              "type": "heatmap",      "dataset": "vw_sla_performance",  "title": "Avg Days Open: Team × Risk Level",  "x": "team_name",      "y": "risk_level",          "metric": "avg_days_open" },
        { "id": "p90_age_by_region",             "type": "bar",          "dataset": "vw_sla_performance",  "title": "P90 Case Age by Region",            "x": "region_name",    "y": "p90_days_open" },
        { "id": "throughput_by_month",           "type": "bar",          "dataset": "vw_sla_performance",  "title": "Monthly Throughput: Opened vs Closed","x": "cohort_month", "metrics": ["total_cases","closed_cases"], "stacked": false }
      ]
    },

